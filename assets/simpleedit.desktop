[Desktop Entry]
Name=SimpleEdit
GenericName=Text Editor
GenericName[fr]=Éditeur de texte
Comment=A fast, stable text editor with syntax highlighting
Comment[fr]=Un éditeur de texte rapide avec coloration syntaxique
Exec=simpleedit %F
Icon=simpleedit
Type=Application
Categories=Utility;TextEditor;
MimeType=text/plain;text/x-makefile;text/x-c++hdr;text/x-c++src;text/x-chdr;text/x-csrc;text/x-java;text/x-moc;text/x-pascal;text/x-tcl;text/x-tex;application/x-shellscript;text/x-c;text/x-c++;text/markdown;application/json;text/x-python;text/x-python3;text/rust;text/x-rust;application/x-yaml;text/yaml;text/x-yaml;application/toml;text/javascript;application/javascript;text/css;text/html;application/xml;text/xml;text/x-sql;text/x-diff;text/x-patch;text/x-go;text/x-lua;text/x-ruby;text/x-csharp;text/x-kotlin;text/x-swift;
StartupWMClass=simpleedit
StartupNotify=true
Terminal=false
Keywords=text;editor;code;syntax;
Keywords[fr]=texte;éditeur;code;syntaxe;
